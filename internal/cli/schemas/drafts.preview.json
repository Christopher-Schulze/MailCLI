{
  "id": "drafts.preview@v1",
  "version": 1,
  "flags": [
    {
      "name": "--ref",
      "value_type": "ref",
      "takes_value": true,
      "value_required": true,
      "required": true,
      "description": "draft ref"
    },
    {
      "name": "--format",
      "value_type": "enum",
      "takes_value": true,
      "value_required": true,
      "default": "plain",
      "values": [
        "plain",
        "source",
        "html"
      ],
      "description": "complete preview format"
    },
    {
      "name": "--json",
      "value_type": "boolean",
      "takes_value": false,
      "description": "emit JSON"
    },
    {
      "name": "--max-bytes",
      "value_type": "bytes",
      "takes_value": true,
      "value_required": true,
      "default": "1048576",
      "minimum": 1,
      "maximum": 67108864,
      "description": "maximum JSON response bytes; oversized previews return inspect/export guidance"
    }
  ],
  "positional_arguments": [],
  "constraints": []
}
