{
  "id": "messages.list@v1",
  "version": 1,
  "flags": [
    {
      "name": "--mailbox",
      "value_type": "ref",
      "takes_value": true,
      "value_required": true,
      "required": true,
      "description": "mailbox reference"
    },
    {
      "name": "--cursor",
      "value_type": "cursor",
      "takes_value": true,
      "value_required": true,
      "description": "pagination cursor"
    },
    {
      "name": "--limit",
      "value_type": "integer",
      "takes_value": true,
      "value_required": true,
      "default": "20",
      "minimum": 1,
      "maximum": 200,
      "description": "page size (1-200)"
    },
    {
      "name": "--max-bytes",
      "value_type": "bytes",
      "takes_value": true,
      "value_required": true,
      "default": "1048576",
      "minimum": 1,
      "maximum": 67108864,
      "description": "maximum JSON response bytes"
    },
    {
      "name": "--json",
      "value_type": "boolean",
      "takes_value": false,
      "description": "emit JSON"
    },
    {
      "name": "--fields",
      "value_type": "field_list",
      "takes_value": true,
      "value_required": true,
      "values": [
        "all",
        "attachment_count",
        "date_received",
        "date_sent",
        "deleted",
        "flagged",
        "junk",
        "message_id",
        "read",
        "sender",
        "size",
        "subject"
      ],
      "description": "comma-separated page fields; refs and page metadata are retained"
    }
  ],
  "positional_arguments": [],
  "constraints": [
    {
      "kind": "conditional",
      "flags": [
        "--fields"
      ],
      "description": "the all page field cannot be combined with any other page field"
    }
  ]
}
