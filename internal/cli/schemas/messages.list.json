{
  "id": "messages.list@v1",
  "version": 1,
  "flags": [
    {
      "name": "--with-threading",
      "value_type": "boolean",
      "takes_value": false,
      "default": "false",
      "description": "read bounded RFC headers; empty values without this flag; threading_complete reports availability"
    },
    {
      "name": "--with-excerpt",
      "value_type": "boolean",
      "takes_value": false,
      "default": "false",
      "description": "read up to 256 KiB local RFC source or a 64 KiB IMAP text prefix per message; excerpt_source and excerpt_complete disclose bounded work"
    },
    {
      "name": "--excerpt-length",
      "value_type": "integer",
      "takes_value": true,
      "value_required": true,
      "default": "240",
      "minimum": 1,
      "maximum": 1000,
      "description": "maximum excerpt runes; effective only when excerpt is requested"
    },
    {
      "name": "--mailbox",
      "value_type": "mailbox_selector",
      "takes_value": true,
      "value_required": true,
      "description": "mailbox ref, role, or exact path; omit for unified inbox"
    },
    {
      "name": "--account",
      "value_type": "ref",
      "takes_value": true,
      "value_required": true,
      "description": "scope to an account ref"
    },
    {
      "name": "--cursor",
      "value_type": "cursor",
      "takes_value": true,
      "value_required": true,
      "description": "pagination cursor"
    },
    {
      "name": "--limit",
      "value_type": "integer",
      "takes_value": true,
      "value_required": true,
      "default": "20",
      "minimum": 1,
      "maximum": 200,
      "description": "page size (1-200)"
    },
    {
      "name": "--max-bytes",
      "value_type": "bytes",
      "takes_value": true,
      "value_required": true,
      "default": "1048576",
      "minimum": 1,
      "maximum": 67108864,
      "description": "maximum JSON response bytes"
    },
    {
      "name": "--json",
      "value_type": "boolean",
      "takes_value": false,
      "description": "emit JSON"
    },
    {
      "name": "--fields",
      "value_type": "field_list",
      "takes_value": true,
      "value_required": true,
      "values": [
        "all",
        "attachment_count",
        "date_received",
        "date_sent",
        "deleted",
        "flagged",
        "junk",
        "message_id",
        "read",
        "sender",
        "size",
        "subject"
      ],
      "description": "comma-separated page fields; refs and page metadata are retained"
    }
  ],
  "positional_arguments": [],
  "constraints": [
    {
      "kind": "conditional",
      "flags": [
        "--fields"
      ],
      "description": "the all page field cannot be combined with any other page field"
    }
  ]
}
