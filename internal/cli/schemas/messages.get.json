{
  "id": "messages.get@v1",
  "version": 1,
  "flags": [
    {
      "name": "--excerpt-length",
      "value_type": "integer",
      "takes_value": true,
      "value_required": true,
      "default": "240",
      "minimum": 1,
      "maximum": 1000,
      "description": "maximum excerpt runes; effective only when excerpt is requested"
    },
    {
      "name": "--ref",
      "value_type": "ref",
      "takes_value": true,
      "value_required": true,
      "repeatable": true,
      "description": "resource reference"
    },
    {
      "name": "--json",
      "value_type": "boolean",
      "takes_value": false,
      "description": "emit JSON"
    },
    {
      "name": "--view",
      "value_type": "enum",
      "takes_value": true,
      "value_required": true,
      "default": "metadata",
      "values": [
        "metadata",
        "plain",
        "full"
      ],
      "description": "output view"
    },
    {
      "name": "--links",
      "value_type": "enum",
      "takes_value": true,
      "value_required": true,
      "default": "full",
      "values": [
        "full",
        "host",
        "none"
      ],
      "description": "URLs in the plain body: full, host (long URLs become <host>) or none; exports stay complete"
    },
    {
      "name": "--fields",
      "value_type": "field_list",
      "takes_value": true,
      "value_required": true,
      "description": "comma-separated JSON fields"
    },
    {
      "name": "--export",
      "value_type": "path",
      "takes_value": true,
      "value_required": true,
      "description": "exclusive absolute path for complete content export"
    },
    {
      "name": "--max-bytes",
      "value_type": "bytes",
      "takes_value": true,
      "value_required": true,
      "default": "1048576",
      "minimum": 1,
      "maximum": 67108864,
      "description": "maximum bounded bytes"
    }
  ],
  "positional_arguments": [
    "REF"
  ],
  "constraints": [
    {
      "kind": "reference_source",
      "flags": [
        "--ref"
      ],
      "fields": [
        "REF"
      ],
      "description": "Supply one non-empty reference; all supplied --ref and REF values must be identical."
    },
    {
      "kind": "mutually_exclusive",
      "flags": [
        "--view",
        "--fields"
      ],
      "description": "--view and --fields cannot be combined"
    },
    {
      "kind": "conditional",
      "flags": [
        "--export",
        "--view",
        "--fields"
      ],
      "description": "--export requires a content-capable view or field and an absolute new path"
    }
  ]
}
