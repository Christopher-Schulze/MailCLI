{
  "id": "messages.thread@v1",
  "version": 1,
  "flags": [
    {
      "name": "--ref",
      "value_type": "ref",
      "takes_value": true,
      "value_required": true,
      "repeatable": true,
      "description": "resource reference"
    },
    {
      "name": "--limit",
      "value_type": "integer",
      "takes_value": true,
      "value_required": true,
      "default": "20",
      "minimum": 1,
      "maximum": 200,
      "description": "page size (1-200)"
    },
    {
      "name": "--cursor",
      "value_type": "cursor",
      "takes_value": true,
      "value_required": true,
      "description": "continuation cursor"
    },
    {
      "name": "--max-bytes",
      "value_type": "bytes",
      "takes_value": true,
      "value_required": true,
      "default": "1048576",
      "minimum": 1,
      "maximum": 67108864,
      "description": "maximum JSON response bytes"
    },
    {
      "name": "--json",
      "value_type": "boolean",
      "takes_value": false,
      "description": "emit JSON"
    }
  ],
  "positional_arguments": [
    "REF"
  ],
  "constraints": [
    {
      "kind": "reference_source",
      "flags": [
        "--ref"
      ],
      "fields": [
        "REF"
      ],
      "description": "Supply one non-empty reference; all supplied --ref and REF values must be identical."
    }
  ]
}
