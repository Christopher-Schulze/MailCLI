{
  "id": "capabilities@v1",
  "version": 1,
  "flags": [
    {
      "name": "--command",
      "value_type": "command_id",
      "takes_value": true,
      "value_required": true,
      "description": "exact command ID to describe"
    },
    {
      "name": "--commands",
      "value_type": "command_id_list",
      "takes_value": true,
      "value_required": true,
      "description": "comma-separated command IDs to describe"
    },
    {
      "name": "--family",
      "value_type": "command_family",
      "takes_value": true,
      "value_required": true,
      "description": "command family to describe"
    },
    {
      "name": "--scope",
      "value_type": "command_id_or_family",
      "takes_value": true,
      "value_required": true,
      "description": "exact command ID or command family to describe"
    },
    {
      "name": "--json",
      "value_type": "boolean",
      "takes_value": false,
      "description": "emit JSON"
    }
  ],
  "positional_arguments": [],
  "constraints": [
    {
      "kind": "mutually_exclusive",
      "flags": [
        "--command",
        "--family",
        "--scope"
      ],
      "description": "at most one capability selector may be supplied"
    },
    {
      "kind": "mutually_exclusive",
      "flags": [
        "--commands",
        "--command",
        "--family",
        "--scope"
      ],
      "description": "--commands cannot be combined with --command, --family, or --scope"
    }
  ]
}
